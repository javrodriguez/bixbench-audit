# Base secret-hygiene ignores (stamped by the Glitch workspace scaffold).
# Reduces accidental staging of secret-NAMED files. It does NOT catch an in-file paste
# or anything already tracked — that needs the secret scan + pre-commit hook (spec §8.5).
.env*
*.pem
*.key
*credentials*
client_secret*.json
*token*.json
.mcp.json
*.mcp.json
.mcp.local.json

# BixBench question bank and capsule data never enter git (E5a addendum 1 section 5).
src/inputs/
data/
*.zip
**/CapsuleData-*/
**/CapsuleNotebook-*/
*.ipynb
# Local evidence that quotes answer keys stays out until a note carries the canary line.
src/runs/**/compare*.txt
# Environments and tools are rebuilt from the lockfile.
env/
tools/
__pycache__/

# --- Glitch publish boundary (added by workspace-git) ---
.planning/
STATE.md
CLAUDE.md
AGENTS.md
